# OpenAlex — search API (key recommended; email alone uses the polite pool)
OPENALEX_API_KEY=
OPENALEX_EMAIL=you@university.edu

# Unpaywall — open-access PDF lookup (use a real email)
UNPAYWALL_EMAIL=you@university.edu

# Anthropic — Claude stages (query generation / extraction when configured)
ANTHROPIC_API_KEY=

# OpenAI-compatible — required for Ollama; any non-empty value works locally
OPENAI_API_KEY=ollama
